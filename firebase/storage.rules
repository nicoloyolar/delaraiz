rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /dossiers/{bandaId}/{carpeta}/{archivo} {

      // Cualquiera puede SUBIR su dossier/rider al postular (formulario
      // público), siempre que sea un PDF de tamaño razonable (<= 15 MB).
      allow create: if
        request.resource.contentType == 'application/pdf' &&
        request.resource.size <= 15 * 1024 * 1024;

      // La banda postulante necesita leer su propio archivo justo
      // después de subirlo (para obtener la downloadURL vía SDK), por lo
      // que el permiso de lectura queda público — igual que el estado
      // por defecto de `getDownloadURL()` en cualquier bucket de Firebase.
      // La URL resultante incluye un token no adivinable, así que en la
      // práctica solo puede acceder al archivo quien tenga ese enlace
      // (la banda que lo subió y la Corporación desde el Dashboard).
      // Si se requiere privacidad estricta, reemplazar por URLs firmadas
      // generadas desde una Cloud Function autenticada.
      allow read: if true;
      allow update, delete: if false;
    }

    match /documentos_institucionales/{documentoId}/{archivo} {
      // Documentación interna: a diferencia de los dossiers de bandas,
      // aquí toda subida viene de la directiva ya autenticada, así que
      // se exige sesión también para leer (sin acceso público).
      allow read, delete: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.contentType == 'application/pdf' &&
        request.resource.size <= 20 * 1024 * 1024;
    }

    // Fotos de bitácora de un proyecto y fotos/documentos de un espacio:
    // uso exclusivamente interno, subidas siempre desde el panel admin
    // ya autenticado.
    match /proyectos/{proyectoId}/{carpeta}/{archivo} {
      allow read, delete: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.size <= 15 * 1024 * 1024;
    }

    match /espacios/{espacioId}/{carpeta}/{archivo} {
      allow read, delete: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.size <= 15 * 1024 * 1024;
    }

    // Comprobantes (PDF) de rendiciones de gastos de una postulación a
    // fondo.
    match /fondos/{postulacionId}/rendiciones/{archivo} {
      allow read, delete: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.contentType == 'application/pdf' &&
        request.resource.size <= 15 * 1024 * 1024;
    }
  }
}
