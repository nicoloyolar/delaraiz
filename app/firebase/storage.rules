rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Mismo chequeo que en firestore.rules: admin autenticado Y activo,
    // leyendo el perfil desde Firestore (posible entre servicios distintos
    // vía `firestore.get`). Reemplaza el "cualquier cuenta autenticada es
    // admin total" anterior — hallazgo de seguridad del análisis del
    // sistema completo, 2026-08-12.
    function esAdminActivo() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.activo == true;
    }

    match /dossiers/{bandaId}/{carpeta}/{archivo} {

      // Cualquiera puede SUBIR su dossier/rider al postular (formulario
      // público), siempre que sea un PDF de tamaño razonable (<= 15 MB).
      allow create: if
        request.resource.contentType == 'application/pdf' &&
        request.resource.size <= 15 * 1024 * 1024;

      // Lectura pública a propósito (decisión tomada 2026-08-12, no
      // cambiada en esta revisión): la banda postulante necesita leer su
      // propio archivo justo después de subirlo (para obtener la
      // downloadURL vía SDK) siendo anónima, y la URL resultante incluye un
      // token no adivinable. Si más adelante se requiere privacidad
      // estricta, reemplazar por URLs firmadas generadas desde una Cloud
      // Function autenticada (requiere plan Blaze de Firebase).
      allow read: if true;
      allow update, delete: if false;
    }

    match /documentos_institucionales/{documentoId}/{archivo} {
      // Documentación interna: a diferencia de los dossiers de bandas,
      // aquí toda subida viene de la directiva ya autenticada, así que
      // se exige ser admin activo también para leer (sin acceso público).
      allow read, delete: if esAdminActivo();
      allow write: if esAdminActivo() &&
        request.resource.contentType == 'application/pdf' &&
        request.resource.size <= 20 * 1024 * 1024;
    }

    // Fotos de bitácora de un proyecto y fotos/documentos de un espacio:
    // uso exclusivamente interno, subidas siempre desde el panel admin
    // ya autenticado.
    match /proyectos/{proyectoId}/{carpeta}/{archivo} {
      allow read, delete: if esAdminActivo();
      allow write: if esAdminActivo() &&
        request.resource.size <= 15 * 1024 * 1024;
    }

    match /espacios/{espacioId}/{carpeta}/{archivo} {
      allow read, delete: if esAdminActivo();
      allow write: if esAdminActivo() &&
        request.resource.size <= 15 * 1024 * 1024;
    }

    // Comprobantes (PDF) de rendiciones de gastos de una postulación a
    // fondo.
    match /fondos/{postulacionId}/rendiciones/{archivo} {
      allow read, delete: if esAdminActivo();
      allow write: if esAdminActivo() &&
        request.resource.contentType == 'application/pdf' &&
        request.resource.size <= 15 * 1024 * 1024;
    }
  }
}
