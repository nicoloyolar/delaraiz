rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica que el usuario autenticado tenga un perfil en `usuarios/{uid}`
    // marcado como admin y activo. Reemplaza el modelo anterior ("cualquier
    // cuenta autenticada es admin total", ver comentario viejo más abajo) —
    // hallazgo de seguridad del análisis del sistema completo, 2026-08-12.
    // El primer usuario admin se crea a mano en la Consola de Firebase:
    // primero la cuenta en Authentication, y ADEMÁS el documento
    // correspondiente acá en Firestore (`usuarios/{uid}` con `rol: "admin"`,
    // `activo: true`) — a propósito no hay auto-registro ni bootstrapping
    // automático que cree ese documento solo.
    function esAdminActivo() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true;
    }

    match /bandas_postulaciones/{bandaId} {

      // Cualquier persona puede postular (formulario público) — pero solo
      // puede crear, nunca leer ni modificar postulaciones ajenas. Debe
      // venir asociada a un proyecto (el que el admin marcó como abierto
      // a postulaciones; ver ProyectoService.streamProyectoConPostulacionesAbiertas).
      allow create: if
        request.resource.data.nombreGrupo is string &&
        request.resource.data.nombreGrupo.size() > 0 &&
        request.resource.data.correoContacto is string &&
        request.resource.data.proyectoId is string &&
        request.resource.data.proyectoId.size() > 0 &&
        request.resource.data.estado == 'pendiente';

      // Leer, actualizar estado o eliminar solo lo puede hacer un admin
      // activo (antes: cualquier cuenta autenticada).
      allow read, update, delete: if esAdminActivo();
    }

    match /documentos_institucionales/{documentoId} {
      // Documentación interna de la Corporación (estatutos, actas,
      // contratos, informes): a diferencia de las postulaciones, aquí no
      // hay escritura pública — solo un admin activo puede leer, crear,
      // actualizar o eliminar.
      allow read, create, update, delete: if esAdminActivo();
    }

    // --- Proyectos y sus subcolecciones ---
    // La entidad central de la plataforma: uso exclusivamente interno.
    match /proyectos/{proyectoId} {
      allow read, create, update, delete: if esAdminActivo();

      match /{subcoleccion}/{docId} {
        allow read, create, update, delete: if esAdminActivo();
      }
    }

    // --- Espacios recuperados ---
    match /espacios/{espacioId} {
      allow read, create, update, delete: if esAdminActivo();
    }

    // --- Equipo y voluntarios ---
    match /personas/{personaId} {
      allow read, create, update, delete: if esAdminActivo();
    }

    // --- Perfiles de acceso al sistema ---
    match /usuarios/{uid} {
      // Cualquier usuario autenticado puede leer SU PROPIO perfil — así la
      // app puede verificar si es admin activo sin quedar en un círculo
      // vicioso (esAdminActivo() necesita poder leer este documento).
      // Todo lo demás (leer perfiles ajenos, crear, modificar, eliminar)
      // requiere ya ser admin activo.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read, create, update, delete: if esAdminActivo();
    }

    // --- Fondos y financiamiento ---
    match /postulaciones_fondos/{postulacionId} {
      allow read, create, update, delete: if esAdminActivo();

      match /rendiciones/{rendicionId} {
        allow read, create, update, delete: if esAdminActivo();
      }
    }

    // --- Agenda de eventos (agregada 2026-08-18) ---
    // Mismo criterio que /postulaciones_fondos: colección de nivel superior
    // (no subcolección de /proyectos) para que la vista global de la Agenda
    // pueda leerla de un solo tiro, filtrando por proyectoId si hace falta.
    match /eventos/{eventoId} {
      allow read, create, update, delete: if esAdminActivo();
    }

    // --- Credencial digital de socios (agregado 2026-08-12) ---
    // El ID de cada documento es el correo del socio en minúsculas. Esta
    // colección la escribe ÚNICAMENTE el sitio PHP, mediante una cuenta de
    // servicio de Firebase (Admin SDK / API REST autenticada) — ese tipo de
    // acceso no pasa por estas reglas de seguridad en absoluto, por eso
    // "allow write: if false" para cualquier cliente (app o navegador) es
    // correcto y no bloquea la sincronización real.
    match /credenciales/{email} {
      // Lectura: el propio socio ve su credencial (self-service, ver
      // `credencial_screen.dart`), o cualquier admin activo ve cualquiera —
      // agregado 2026-08-14 para el mantenedor de Socios del panel admin
      // (`socios_list_screen.dart`), que necesita listar la colección
      // completa, no un documento a la vez.
      allow read: if (request.auth != null && request.auth.token.email.lower() == email)
        || esAdminActivo();

      // Escritura: sigue bloqueada para los campos reales de la suscripción
      // (`estado`, `plan`, `proximoCobro`, etc.) — esos solo los toca el
      // sitio PHP mediante una cuenta de servicio, que no pasa por estas
      // reglas en absoluto. La ÚNICA excepción es la capa de moderación
      // manual (aprobar/rechazar/bloquear un socio desde el panel admin):
      // un admin activo puede actualizar exclusivamente esos 2 campos, en
      // un documento que ya existe (nunca crear uno nuevo desde acá).
      allow update: if esAdminActivo()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estadoModeracion', 'estadoModeracionActualizadoEn']);
    }

    // --- Locales adheridos al beneficio de acceso de Embajador (2026-09-23) ---
    // Lectura abierta a cualquier autenticado: el propio socio necesita ver
    // la lista de locales activos para elegir uno al generar su cupón —
    // escritura (crear/editar/eliminar) solo un admin desde el panel.
    match /locales/{localId} {
      allow read: if request.auth != null;
      allow create, update, delete: if esAdminActivo();
    }

    // --- Cupón de acceso QR de Embajador (2026-09-23, sección 9.15/9.25) ---
    // El ID de cada documento es el código aleatorio del cupón (no
    // adivinable). A propósito NO hay `update`/`delete` para ningún cliente
    // — quien valida el cupón en la puerta de un local no tiene cuenta de
    // Firebase, así que esa escritura (pasar de "vigente" a "usado") la hace
    // el sitio PHP con su cuenta de servicio, que no pasa por estas reglas.
    match /cupones_acceso/{codigo} {
      // Lectura: solo el propio dueño (para poder mostrar su QR/cuenta
      // regresiva mientras esté vigente) — nadie más puede leer un cupón
      // ajeno ni antes ni después de usarlo, la validación en el local nunca
      // necesita leer desde el navegador del cliente (ver
      // ValidarCuponScreen/cdlr_validar_cupon_acceso, que usa la cuenta de
      // servicio).
      allow read: if request.auth != null
        && request.auth.token.email.lower() == resource.data.socioEmail;

      // Creación: el propio socio crea su propio cupón, siempre en estado
      // "vigente" — no se valida acá que no tenga ya uno vigente (la app ya
      // lo bloquea del lado cliente); una carrera exacta entre 2 clics es un
      // caso extremo aceptable, no justifica una Cloud Function aparte.
      allow create: if request.auth != null
        && request.auth.token.email.lower() == request.resource.data.socioEmail
        && request.resource.data.estado == 'vigente';

      allow update, delete: if false;
    }
  }
}
